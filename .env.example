# Copy to .env and rotate all secrets before production use.
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# PostgreSQL (5432 = Docker Compose; 5433 = npm run db:local embedded)
DATABASE_URL=postgresql://gow:gow_change_me@localhost:5432/gow?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gowminio
S3_SECRET_KEY=gowminio_change_me
S3_BUCKET=gov-office-files
S3_REGION=us-east-1

# Auth / crypto (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_64_char_hex_access_secret________________
JWT_REFRESH_SECRET=replace_with_64_char_hex_refresh_secret_______________
FILE_ENCRYPTION_MASTER_KEY=replace_with_64_char_hex_file_master_key______
COOKIE_SECURE=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
VAULT_UNLOCK_TTL_MINUTES=30

# MFA: require TOTP after enrollment
# Testing/UAT: false. Pilot: true (+ NEXT_PUBLIC_MFA_REQUIRED=true in apps/web/.env.local)
MFA_REQUIRED=false
NEXT_PUBLIC_MFA_REQUIRED=false
# Demo only — never set true for pilot/production (ignored when PILOT_MODE=true)
# MFA_SKIP_LOGIN_TOTP=true
# DEMO_WEAK_PASSWORDS=true

# Pilot hardening (see deploy/.env.pilot.example)
# PILOT_MODE=true
# SEED_PASSWORD=ChangeMe!Office1

# Optional LDAP/AD (Phase 4)
LDAP_ENABLED=false
LDAP_URL=ldaps://ldap.example.gov:636
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=ou=Users,dc=example,dc=gov

# Optional AI (Phase 5) — leave empty for on-prem local grounded briefing (no external call)
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
# Must stay false for NA pilot: parliamentary data must never train external models
AI_ALLOW_EXTERNAL_TRAINING=false

# Optional e-sign provider (Phase 4) — local_pki | docusign | none
ESIGN_PROVIDER=local_pki
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_PATH=

# OCR — eng+urd for bilingual scans; vision fallback uses AI_API_KEY when local OCR is weak
OCR_ENABLED=true
OCR_LANGS=eng+urd
OCR_PDF_MAX_PAGES=8
OCR_PDF_SCALE=2.75
OCR_VISION_FALLBACK=true
OCR_PREFER_VISION=true
OCR_VISION_MAX_PAGES=5
# AI_VISION_MODEL=gpt-4o-mini
