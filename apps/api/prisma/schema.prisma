generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SPEAKER
  SECRETARY_GENERAL
  SPECIAL_SECRETARY
  DG_IT
  ADMIN
}

enum Classification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
}

enum MatterStatus {
  OPEN
  IN_PROGRESS
  AWAITING_RECEIPT
  AWAITING_DECISION
  CLOSED
}

enum DirectionStatus {
  ISSUED
  IN_PROGRESS
  EVIDENCE_SUBMITTED
  RETURNED
  CLOSED
  OVERDUE
  ESCALATED
}

enum WorkItemStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum MeetingStatus {
  REQUESTED
  APPROVED
  DECLINED
  COMPLETED
  ARCHIVED
}

enum CallStatus {
  LOGGED
  FOLLOW_UP
  CLOSED
}

enum PressStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  DISPATCHED
}

enum EsignStatus {
  PENDING
  SIGNED
  DECLINED
  REVOKED
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  displayName        String
  email              String    @unique
  passwordHash       String
  role               Role
  mfaSecretEnc       String?
  mfaEnabled         Boolean   @default(false)
  active             Boolean   @default(true)
  ldapDn             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  refreshTokens      RefreshToken[]
  assignedMatters    Matter[]  @relation("Assignee")
  heldMatters        Matter[]  @relation("Holder")
  createdMatters     Matter[]  @relation("Creator")
  versions           MatterVersion[]
  notes              MatterNote[]
  routeStepsFrom     RouteStep[] @relation("FromUser")
  routeStepsTo       RouteStep[] @relation("ToUser")
  directionsOwned    Direction[] @relation("DirectionOwner")
  directionsCreated  Direction[] @relation("DirectionCreator")
  vaultGrants        VaultGrant[]
  notifications      Notification[]
  messagesSent       Message[] @relation("MsgFrom")
  messagesRecv       Message[] @relation("MsgTo")
  callsLogged        CallRecord[]
  workItemsOwned     WorkItem[] @relation("WorkOwner")
  workItemsCreated   WorkItem[] @relation("WorkCreator")
  workItemsDecided   WorkItem[] @relation("WorkDecider")
  meetingsCreated    Meeting[]  @relation("MeetingCreator")
  speeches           Speech[]
  pressReleases      PressRelease[]
  mediaClips         MediaClip[]
  greetings          GreetingCard[]
  esignRecords       EsignRecord[] @relation("EsignSigner")
  esignRequested     EsignRecord[] @relation("EsignRequester")
  scheduleItems      ScheduleItem[]
  meetingActions     MeetingAction[] @relation("MeetingActionOwner")
  auditEvents        AuditEvent[]
  dakStamped         DakEntry[] @relation("DakStamp")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Matter {
  id               String         @id @default(uuid())
  diaryNo          String         @unique
  subject          String
  sender           String
  body             String
  classification   Classification
  subjectArea      String
  priority         String         @default("NORMAL")
  status           MatterStatus   @default(OPEN)
  filePasswordHash String?
  createdById      String
  createdBy        User           @relation("Creator", fields: [createdById], references: [id])
  assigneeId       String?
  assignee         User?          @relation("Assignee", fields: [assigneeId], references: [id])
  holderId         String?
  holder           User?          @relation("Holder", fields: [holderId], references: [id])
  decisionText     String?
  decisionType     String?
  closedAt         DateTime?
  sentForEsign     Boolean        @default(false)
  /// AI-assisted summary pending human accept (Tech §6 / §4 human-controlled)
  aiSummary           String?
  aiSummaryLang       String?
  aiSummaryAcceptedAt DateTime?
  aiSummaryAcceptedById String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  versions         MatterVersion[]
  notes            MatterNote[]
  attachments      Attachment[]
  routeSteps       RouteStep[]
  relatedFrom      MatterRelation[] @relation("FromMatter")
  relatedTo        MatterRelation[] @relation("ToMatter")
  letters          Letter[]
  directions       Direction[]
  vaultGrants      VaultGrant[]
  calls            CallRecord[]
  workItems        WorkItem[]
  esignRecords     EsignRecord[]
  speeches         Speech[]
  pressReleases    PressRelease[]
  greetingCards    GreetingCard[]
  journeyEvents    JourneyEvent[]
  messages         Message[]
  dakEntries       DakEntry[]
}

model MatterVersion {
  id        String   @id @default(uuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  reason    String
  kind      String   @default("WORKING")
  hash      String
  createdAt DateTime @default(now())
}

model MatterNote {
  id        String   @id @default(uuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  /// NOTE | PUT_UP | OBSERVATION — append-only noting sheet (S1-02)
  kind      String   @default("NOTE")
  number    Int
  createdAt DateTime @default(now())
}

model MatterRelation {
  id           String @id @default(uuid())
  fromMatterId String
  toMatterId   String
  fromMatter   Matter @relation("FromMatter", fields: [fromMatterId], references: [id], onDelete: Cascade)
  toMatter     Matter @relation("ToMatter", fields: [toMatterId], references: [id], onDelete: Cascade)
}

model Attachment {
  id               String   @id @default(uuid())
  matterId         String
  matter           Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  fileName         String
  contentType      String
  sizeBytes        Int
  storageKey       String
  sha256           String
  encrypted        Boolean  @default(false)
  wrappedDek       String?
  extractedText    String?
  createdAt        DateTime @default(now())
}

model RouteStep {
  id           String    @id @default(uuid())
  matterId     String
  matter       Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  fromUserId   String?
  fromUser     User?     @relation("FromUser", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User      @relation("ToUser", fields: [toUserId], references: [id])
  procedure    String
  remarks      String?
  dueDate      DateTime?
  status       String    @default("AWAITING_RECEIPT")
  outcome      String?
  createdAt    DateTime  @default(now())
  acknowledgedAt DateTime?
  completedAt  DateTime?
}

model JourneyEvent {
  id        String   @id @default(uuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  kind      String
  summary   String
  actorId   String?
  metaJson  String?
  createdAt DateTime @default(now())
}

model Letter {
  id         String   @id @default(uuid())
  matterId   String
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  recipient  String
  text       String
  status     String   @default("DRAFT")
  method     String?
  reference  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Direction {
  id          String          @id @default(uuid())
  matterId    String?
  matter      Matter?         @relation(fields: [matterId], references: [id])
  title       String
  status      DirectionStatus @default(ISSUED)
  ownerId     String
  owner       User            @relation("DirectionOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User            @relation("DirectionCreator", fields: [createdById], references: [id])
  dueDate     DateTime?
  evidence    String?
  /// Completion evidence file (S1-04)
  evidenceFileName    String?
  evidenceContentType String?
  evidenceSizeBytes   Int?
  evidenceStorageKey  String?
  evidenceSha256      String?
  escalateNote String?
  reminderSentAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  calls       CallRecord[]
  meetingActions MeetingAction[]
}

model VaultGrant {
  id        String   @id @default(uuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  recordId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id          String              @id @default(uuid())
  fromUserId  String
  fromUser    User                @relation("MsgFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User                @relation("MsgTo", fields: [toUserId], references: [id])
  text        String              @default("")
  textEnc     Boolean             @default(true)
  priority    String              @default("ROUTINE")
  matterId    String?
  matter      Matter?             @relation(fields: [matterId], references: [id])
  read        Boolean             @default(false)
  createdAt   DateTime            @default(now())
  attachments MessageAttachment[]
}

model MessageAttachment {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String
  sizeBytes   Int
  storageKey  String
  sha256      String
  createdAt   DateTime @default(now())
}

model CallRecord {
  id             String     @id @default(uuid())
  loggedById     String
  loggedBy       User       @relation(fields: [loggedById], references: [id])
  direction      String
  priority       String     @default("NORMAL")
  status         CallStatus @default(LOGGED)
  partyName      String
  organisation   String?
  phone          String?
  addressedTo    String?
  summary        String
  actionRequired String?
  followUpNotes  String?
  matterId       String?
  matter         Matter?    @relation(fields: [matterId], references: [id])
  directionId    String?
  directionRef   Direction? @relation(fields: [directionId], references: [id])
  meetingId      String?
  createdAt      DateTime   @default(now())
}

model WorkItem {
  id             String             @id @default(uuid())
  code           String?
  title          String
  kind           String
  language       String             @default("en")
  status         WorkItemStatus     @default(DRAFT)
  classification Classification     @default(INTERNAL)
  priority       String             @default("NORMAL")
  text           String
  ownerId        String
  owner          User               @relation("WorkOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      User               @relation("WorkCreator", fields: [createdById], references: [id])
  matterId       String?
  matter         Matter?            @relation(fields: [matterId], references: [id])
  rejectReason   String?
  decisionNote   String?
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      User?              @relation("WorkDecider", fields: [decidedById], references: [id])
  dueAt          DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Meeting {
  id              String        @id @default(uuid())
  title           String
  status          MeetingStatus @default(REQUESTED)
  startAt         DateTime?
  endAt           DateTime?
  location        String?
  brief           String?
  minutes         String?
  outcome         String?
  decision        String?
  screeningStatus String?
  screeningCnic   String?
  screeningBadge  String?
  screeningNotes  String?
  createdById     String
  createdBy       User          @relation("MeetingCreator", fields: [createdById], references: [id])
  archived        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  actions         MeetingAction[]
}

model MeetingAction {
  id          String     @id @default(uuid())
  meetingId   String
  meeting     Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title       String
  ownerName   String
  ownerId     String?
  owner       User?      @relation("MeetingActionOwner", fields: [ownerId], references: [id])
  dueDate     DateTime?
  directionId String?    @unique
  direction   Direction? @relation(fields: [directionId], references: [id])
  createdAt   DateTime   @default(now())
}

model ScheduleItem {
  id          String   @id @default(uuid())
  title       String
  startAt     DateTime
  endAt       DateTime
  location    String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
}

/// R&I receive / despatch register (NA circular-style stamp fields)
model DakEntry {
  id               String    @id @default(uuid())
  direction        String    // IN | OUT
  branchName       String    @default("Speaker Office")
  fromName         String
  fromDesignation  String?
  toName           String
  toDesignation    String?
  channel          String    @default("HAND") // HAND | POST | EMAIL | INTERNAL
  subject          String
  classification   String?
  diaryNo          String?
  matterId         String?
  matter           Matter?   @relation(fields: [matterId], references: [id])
  reference        String?
  stampedAt        DateTime  @default(now())
  stampedById      String
  stampedBy        User      @relation("DakStamp", fields: [stampedById], references: [id])
  createdAt        DateTime  @default(now())
}

/// Multi-step routing presets (Tech / research file movement)
model RouteTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  /// JSON array: [{ "toRole": "SECRETARY_GENERAL", "procedure": "Examine and advise" }, ...]
  stepsJson   String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Speech {
  id               String    @id @default(uuid())
  title            String
  /// Primary remarks (usually English or chosen language)
  body             String
  /// Optional Urdu / second-language body for bilingual delivery
  bodyUr           String?
  /// Structured talking points (EN) — source-assisted briefing bullets
  talkingPoints    String?
  talkingPointsUr  String?
  language         String    @default("en")
  status           String    @default("DRAFT")
  authorId         String
  author           User      @relation(fields: [authorId], references: [id])
  /// Linked authorized matter for source traceability (consultation §3.5)
  matterId         String?
  matter           Matter?   @relation(fields: [matterId], references: [id], onDelete: SetNull)
  /// Free-text source citations (diary nos, brief titles, attachments)
  sourcesNote      String?
  eventDate        DateTime?
  eventVenue       String?
  /// AI assisted drafting — must stay human-reviewed before APPROVED
  aiAssisted       Boolean   @default(false)
  humanReviewedAt  DateTime?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PressRelease {
  id               String      @id @default(uuid())
  title            String
  titleUr          String?
  body             String
  bodyUr           String?
  code             String?
  pidRef           String?
  wire             String?     @default("PID, PTV News, Radio Pakistan, APP, National Parliamentary Reporters")
  /// Approved social channels for review support (consultation §3.5)
  socialTargets    String?     @default("X / Twitter, Facebook, Instagram (official NA accounts only)")
  socialApproved   Boolean     @default(false)
  matterId         String?
  matter           Matter?     @relation(fields: [matterId], references: [id], onDelete: SetNull)
  sourcesNote      String?
  embargoUntil     DateTime?
  aiAssisted       Boolean     @default(false)
  humanReviewedAt  DateTime?
  rejectReason     String?
  status           PressStatus @default(DRAFT)
  authorId         String
  author           User        @relation(fields: [authorId], references: [id])
  approvedAt       DateTime?
  dispatchedAt     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  clips            MediaClip[]
}

/// Press / social pickup monitoring (consultation §3.5 media review support)
model MediaClip {
  id             String        @id @default(uuid())
  outlet         String
  headline       String
  url            String?
  note           String?
  platform       String?       @default("WIRE")
  observedAt     DateTime      @default(now())
  pressReleaseId String?
  pressRelease   PressRelease? @relation(fields: [pressReleaseId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
}

model GreetingCard {
  id               String      @id @default(uuid())
  occasion         String
  occasionKey      String?
  occasionDate     DateTime?
  titleUr          String?
  recipient        String
  recipientCount   Int         @default(0)
  message          String
  messageUr        String?
  style            String      @default("STATE_GOLD")
  /// PROTOCOL_ECARD | PRINT | BOTH
  channel          String      @default("PROTOCOL_ECARD")
  cardCode         String?
  dispatchRef      String?
  matterId         String?
  matter           Matter?     @relation(fields: [matterId], references: [id], onDelete: SetNull)
  sourcesNote      String?
  deliveryNote     String?
  aiAssisted       Boolean     @default(false)
  humanReviewedAt  DateTime?
  rejectReason     String?
  status           PressStatus @default(DRAFT)
  authorId         String
  author           User        @relation(fields: [authorId], references: [id])
  approvedAt       DateTime?
  dispatchedAt     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model EsignRecord {
  id            String      @id @default(uuid())
  matterId      String
  matter        Matter      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  signerId      String
  signer        User        @relation("EsignSigner", fields: [signerId], references: [id])
  requestedById String?
  requestedBy   User?       @relation("EsignRequester", fields: [requestedById], references: [id])
  status        EsignStatus @default(PENDING)
  certId        String?     @unique
  /// LOCAL_PKI (ETO-style advanced under sole control) | WET_INK (scanned wet signature)
  method        String      @default("LOCAL_PKI")
  purpose       String?
  documentHash  String?
  algorithm     String?     @default("RSA-SHA256")
  signature     String?
  provider      String      @default("local_pki")
  declineReason String?
  revokeReason  String?
  wetInkNote    String?
  signedAt      DateTime?
  createdAt     DateTime    @default(now())
}

model AuditEvent {
  id         String   @id @default(uuid())
  seq        Int      @unique @default(autoincrement())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  summary    String
  ip         String?
  userAgent  String?
  prevHash   String
  hash       String
  createdAt  DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
