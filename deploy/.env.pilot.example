# Pilot profile — copy to apps/api/.env (or root .env) for a pilot deployment.
# Do NOT use demo bypass flags. Rotate every secret before go-live.

NODE_ENV=production
PILOT_MODE=true

APP_URL=https://office.example.gov
API_URL=https://office.example.gov
API_PORT=4000
COOKIE_SECURE=true

DATABASE_URL=postgresql://gow:CHANGE_ME@localhost:5432/gow?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=gov-office-files
S3_REGION=us-east-1

# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FILE_ENCRYPTION_MASTER_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
VAULT_UNLOCK_TTL_MINUTES=30

# Gate 0 — MFA must be enforced; never skip TOTP in pilot
MFA_REQUIRED=true
# MFA_SKIP_LOGIN_TOTP must be absent or false
MFA_SKIP_LOGIN_TOTP=false

# Strong password policy (no demo weak mode)
DEMO_WEAK_PASSWORDS=false

# Seed once with a strong password, then force users to change it
SEED_PASSWORD=ChangeMe!Pilot2026
# ALLOW_WEAK_SEED=true   # never set in real pilot

LDAP_ENABLED=false
ESIGN_PROVIDER=local_pki
